# Copy this file to .env and fill in real values for your own local setup.
# .env is gitignored - never commit real credentials.
#
# These control the passwords seed_data.py assigns to the demo accounts it
# creates (Admin/Manager/Employee tiers). If unset, seed_data.py falls back
# to the placeholder values below - fine for a disposable local database,
# but don't rely on them for anything reachable by anyone else.
SEED_ADMIN_PASSWORD=changeme-admin
SEED_MANAGER_PASSWORD=changeme-manager
SEED_EMPLOYEE_PASSWORD=changeme-employee
